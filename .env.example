# Copy to .env and fill in, or set these in your MCP client's `env` block.
# Never commit a filled-in copy: AUTH_MCP_OAUTH_CLIENT_SECRET is a credential.

# --- Transport -------------------------------------------------------------
AUTH_MCP_TRANSPORT=stdio
# AUTH_MCP_HTTP_HOST=127.0.0.1
# AUTH_MCP_HTTP_PORT=8080
# AUTH_MCP_HTTP_ENDPOINT=/mcp
# Names clients may connect with, besides loopback and the --host address.
# host:port or a URL; comma-separated. Required with --host 0.0.0.0, or the
# Host/Origin check is off. See LOCAL_NETWORK.md.
# AUTH_MCP_ALLOWED_ORIGINS=mymac.local:8080,192.168.1.20:8080
AUTH_MCP_LOG_LEVEL=info

# --- Credentials -----------------------------------------------------------
# Sign-in survives restarts by default on stdio. Turn off to make it
# process-lifetime only.
# AUTH_MCP_PERSIST_CREDENTIALS=true
# keychain | file | memory. Default prefers the keychain, falls back to file.
# AUTH_MCP_CREDENTIAL_BACKEND=keychain
# AUTH_MCP_CREDENTIAL_DIR=~/.config/authentication-mcp

# --- Authorization server --------------------------------------------------
# oauth | google | mock
AUTH_MCP_PROVIDER=oauth

# --- Google ----------------------------------------------------------------
# Register an OAuth client of type "Desktop app" in the Google Cloud Console.
# Google does not support Dynamic Client Registration, so this is manual.
# The secret ships in the binary and is not truly secret; PKCE protects the flow.
# AUTH_MCP_GOOGLE_CLIENT_ID=123....apps.googleusercontent.com
# AUTH_MCP_GOOGLE_CLIENT_SECRET=GOCSPX-...
# Google will never grant data:read / data:write, so scope checks default to off.
# AUTH_MCP_SCOPE_READ=https://www.googleapis.com/auth/drive.readonly
# AUTH_MCP_SCOPE_WRITE=none
# Only for AUTH_MCP_PROVIDER=oauth (ignored for google).
AUTH_MCP_OAUTH_ISSUER=https://your-idp.example.com
AUTH_MCP_OAUTH_CLIENT_ID=your-client-id
# Omit entirely for a public client (PKCE only).
# AUTH_MCP_OAUTH_CLIENT_SECRET=
# none | basic | post
# AUTH_MCP_OAUTH_AUTH_METHOD=none
AUTH_MCP_OAUTH_SCOPES=data:read data:write
# Audience-restricts the issued token to one API (RFC 8707).
# AUTH_MCP_OAUTH_RESOURCE=https://api.example.com

# Only needed when the provider's discovery document is incomplete.
# AUTH_MCP_OAUTH_AUTHORIZATION_ENDPOINT=
# AUTH_MCP_OAUTH_TOKEN_ENDPOINT=
# AUTH_MCP_OAUTH_DEVICE_ENDPOINT=
# AUTH_MCP_OAUTH_REVOCATION_ENDPOINT=

# --- Data store ------------------------------------------------------------
AUTH_MCP_STORE=memory
# AUTH_MCP_STORE_PATH=./.authentication-service/records

# --- Development only ------------------------------------------------------
# Set AUTH_MCP_PROVIDER=mock to run with no identity provider at all.
# immediate | manual | deny | delay:<seconds>
# AUTH_MCP_MOCK_POLICY=immediate
